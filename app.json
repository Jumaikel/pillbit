{
  "expo": {
    "name": "pillbit",
    "slug": "pillbit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "pillbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/monochrome-icon.png"
      },
      "notification": {
        "icon": "./assets/icons/notification-icon.png",
        "color": "#208AEF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jumaikel.pillbit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/icons/splash-icon.png",
          "dark": {
            "backgroundColor": "#1A1A1A",
            "image": "./assets/icons/splash-icon.png"
          },
          "android": {
            "image": "./assets/icons/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a PillBit acceder a tus fotos para elegir imágenes de medicamentos.",
          "cameraPermission": "Permitir a PillBit acceder a tu cámara para fotografiar tus medicamentos."
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "106a4d59-1da5-426d-812e-a198e3eece25"
      }
    }
  }
}
